+		return targetBucket;
+
+	const int currentBucket = juce::jlimit (64, kMaxFftSize, nextPowerOf2 (currentFftSize));
+	float lowerStayBound = 0.0f;
+	float upperStayBound = (float) std::numeric_limits<int>::max();
