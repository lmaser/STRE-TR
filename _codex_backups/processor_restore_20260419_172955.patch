+void STRETRAudioProcessor::refreshFft2TransitionPreviewState (const StftState& sourceState,
+                                                              const Fft2RuntimeState& sourceRuntime,
+                                                              StftState& destState,
+                                                              Fft2RuntimeState& destRuntime) noexcept
+{
+	// FFT2 transition preview should follow the active cloud, not grow its own
+	// independent memory while the window handoff is in flight.
+	const int sourceFftSize = sourceState.activeFftSize;
+	const int destFftSize = destState.activeFftSize;
+	if (sourceFftSize <= 0 || destFftSize <= 0 || ! sourceState.hasFrame || ! sourceRuntime.hasCanonicalMemory)
+		return;
+
+	const int sourceBins = juce::jlimit (1, kMaxFftBins, sourceFftSize / 2 + 1);
+	const int destBins = juce::jlimit (1, kMaxFftBins, destFftSize / 2 + 1);
+	const bool initialiseSynthPhase = ! destState.hasFrame || destState.cyclesSinceReset <= 0;
+
+	auto binPosForDest = [sourceBins, destBins] (int destBin) noexcept
+	{
+		if (destBins <= 1 || sourceBins <= 1)
+			return 0.0f;
+
+		return ((float) destBin / (float) (destBins - 1)) * (float) (sourceBins - 1);
+	};
+
+	auto sampleLinear = [sourceBins] (const float* src, float srcPos) noexcept
+	{
+		const int s0 = juce::jlimit (0, sourceBins - 1, (int) std::floor (srcPos));
+		const int s1 = juce::jlimit (0, sourceBins - 1, s0 + 1);
+		const float frac = juce::jlimit (0.0f, 1.0f, srcPos - (float) s0);
+		return src[s0] + (src[s1] - src[s0]) * frac;
+	};
+
+	auto samplePhase = [sourceBins] (const float* src, float srcPos) noexcept
+	{
+		const int s0 = juce::jlimit (0, sourceBins - 1, (int) std::floor (srcPos));
+		const int s1 = juce::jlimit (0, sourceBins - 1, s0 + 1);
+		const float frac = juce::jlimit (0.0f, 1.0f, srcPos - (float) s0);
+		const float a = src[s0];
+		const float b = src[s1];
+		return wrapPhaseToPiFast (a + wrapPhaseToPiFast (b - a) * frac);
+	};
+
+	destRuntime.hasSpectralMemory = sourceRuntime.hasSpectralMemory;
+	destRuntime.hasCanonicalMemory = sourceRuntime.hasCanonicalMemory;
+	destRuntime.hasAnalysisPhaseMemory = sourceRuntime.hasAnalysisPhaseMemory;
+	destRuntime.frozen = sourceRuntime.frozen;
+	destRuntime.smoothedWindowNorm = sourceRuntime.smoothedWindowNorm;
+	destRuntime.smoothedAcquireMix = sourceRuntime.smoothedAcquireMix;
+	destRuntime.smoothedSpectralDiffusion = sourceRuntime.smoothedSpectralDiffusion;
+	destRuntime.lastHoldCoeff = sourceRuntime.lastHoldCoeff;
+	destRuntime.cloudAnalysisSampleAccumulator = sourceRuntime.cloudAnalysisSampleAccumulator;
+	destRuntime.lastCloudAnalysisHop = sourceRuntime.lastCloudAnalysisHop;
+
+	for (int ch = 0; ch < 2; ++ch)
+	{
+		std::memcpy (destRuntime.analysisPrevPhase[ch], sourceRuntime.analysisPrevPhase[ch],
+		             sizeof (destRuntime.analysisPrevPhase[ch]));
+		std::memcpy (destRuntime.canonicalHeldMag[ch], sourceRuntime.canonicalHeldMag[ch],
+		             sizeof (destRuntime.canonicalHeldMag[ch]));
+		std::memcpy (destRuntime.canonicalHeldFreq[ch], sourceRuntime.canonicalHeldFreq[ch],
+		             sizeof (destRuntime.canonicalHeldFreq[ch]));
+
+		for (int k = 0; k < destBins; ++k)
+		{
+			const float srcPos = binPosForDest (k);
+			destState.prevPhase[ch][k] = samplePhase (sourceState.prevPhase[ch], srcPos);
+			destState.prevMag[ch][k] = sampleLinear (sourceState.prevMag[ch], srcPos);
+			destState.lastMag[ch][k] = sampleLinear (sourceState.lastMag[ch], srcPos);
+			destState.lastFreq[ch][k] = sampleLinear (sourceState.lastFreq[ch], srcPos);
+			if (initialiseSynthPhase)
+				destState.synthPhase[ch][k] = samplePhase (sourceState.synthPhase[ch], srcPos);
+		}
+	}
+
+	destState.hasFrame = true;
+	destState.cyclesSinceReset = juce::jmax (1, sourceState.cyclesSinceReset);
+}
