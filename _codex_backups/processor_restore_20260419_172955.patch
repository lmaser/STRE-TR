+	static bool resolveStretrDirectFftwSymbols()
+	{
+		if (g_stretrDirectFftw.resolved)
+			return true;
+
+		ensureStretrFftwLoaded();
+		if (HMODULE module = GetModuleHandleW (L"libfftw3f.dll"))
+		{
+			auto bind = [module] (auto& dst, const char* name) -> bool
+			{
+				dst = reinterpret_cast<std::remove_reference_t<decltype (dst)>> (GetProcAddress (module, name));
+				return dst != nullptr;
+			};
+
+			if (bind (g_stretrDirectFftw.planR2C, "fftwf_plan_dft_r2c_1d")
+			    && bind (g_stretrDirectFftw.planC2R, "fftwf_plan_dft_c2r_1d")
+			    && bind (g_stretrDirectFftw.destroyPlan, "fftwf_destroy_plan")
+			    && bind (g_stretrDirectFftw.executeR2C, "fftwf_execute_dft_r2c")
+			    && bind (g_stretrDirectFftw.executeC2R, "fftwf_execute_dft_c2r"))
+			{
+				g_stretrDirectFftw.resolved = true;
+				return true;
+			}
+		}
+
+		return false;
+	}
