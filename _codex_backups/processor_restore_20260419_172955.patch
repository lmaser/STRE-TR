+int STRETRAudioProcessor::effectiveFft1GuardrailSize (int requestedFftSize, float amount, float pitchRate) const noexcept
+{
+	if (requestedFftSize <= 0)
+		return 0;
+
+	const float clampedSize = juce::jlimit ((float) kWindowMin,
+	                                        (float) kWindowMax,
+	                                        (float) requestedFftSize);
+	const float lowWindowNorm = juce::jlimit (0.0f, 1.0f,
+	                                          (48.0f - clampedSize) / (48.0f - (float) kWindowMin));
+	const float lowWindowWeight = lowWindowNorm * lowWindowNorm * (3.0f - 2.0f * lowWindowNorm);
