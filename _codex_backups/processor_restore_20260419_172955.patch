+	inline float windowValueFromNormalised (float norm) noexcept
+	{
+		norm = juce::jlimit (0.0f, 1.0f, norm);
+		if (norm <= 0.5f)
+		{
+			const float t = norm * 2.0f;
+			return 16.0f * std::pow (64.0f, t);
+		}
+
+		const float t = (norm - 0.5f) * 2.0f;
+		return 1024.0f * std::pow (8.0f, t);
+	}
+
+	inline float windowNormalisedFromValue (float value) noexcept
+	{
+		value = juce::jlimit (16.0f, 8192.0f, value);
+		if (value <= 1024.0f)
+			return 0.5f * (std::log (value / 16.0f) / std::log (64.0f));
+
+		return 0.5f + 0.5f * (std::log (value / 1024.0f) / std::log (8.0f));
+	}
+
+	inline juce::NormalisableRange<float> makeWindowRange()
+	{
+		return {
+			(float) STRETRAudioProcessor::kWindowMin,
+			(float) STRETRAudioProcessor::kWindowMax,
+			[] (float, float, float norm)
+			{
+				return windowValueFromNormalised (norm);
+			},
+			[] (float, float, float value)
+			{
+				return windowNormalisedFromValue (value);
+			},
+			[] (float start, float end, float value)
+			{
+				return (float) juce::jlimit ((int) start, (int) end, (int) std::lround (value));
+			}
+		};
+	}
