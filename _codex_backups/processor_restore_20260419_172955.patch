+		fftWindowState_.sizeTransitionTotal = 0;
+		fftWindowState_.sizeTransitionRemaining = 0;
+		fftWindowState_.sizeTransitionWarmupTotal = 0;
+		return;
+	}
+
+	const int oldHop = recommendedFftSynthHopForEngine (engineVal, oldFftSize);
+	const int newHop = recommendedFftSynthHopForEngine (engineVal, newFftSize);
+	const int oldWetLatency = oldFftSize + oldHop;
+	const int newWetLatency = newFftSize + newHop;
+	int transitionLen = juce::jlimit (64,
+	                                  kFftWetHistoryLen - 1,
+	                                  juce::jmax (oldWetLatency, newWetLatency));
+	if (engineVal == 3)
+	{
+		const float liveBlend = juce::jlimit (0.0f, 1.0f,
+		                                      juce::jmax (fftWindowState_.fft2LiveTransitionBlend,
+		                                                  fft2LiveTransitionBlend));
+		fftWindowState_.fft2LiveTransitionBlend = liveBlend;
+		const float transitionScale = juce::jlimit (0.80f, 1.40f, 1.40f - 0.60f * liveBlend);
+		transitionLen = juce::jlimit (48,
+		                              kFftWetHistoryLen - 1,
+		                              (int) std::lround ((float) transitionLen * transitionScale));
+		if (fftWindowState_.fft2Downsizing)
+		{
+			transitionLen = juce::jlimit (16,
+			                              kFftWetHistoryLen - 1,
+			                              (int) std::lround ((float) transitionLen * 0.25f));
+		}
+	}
+	else
+	{
+		fftWindowState_.fft2LiveTransitionBlend = 0.0f;
+		fftWindowState_.fft2Downsizing = false;
+	}
+	fftWindowState_.engine = engineVal;
+	fftWindowState_.sizeTransitionTotal = transitionLen;
+	fftWindowState_.sizeTransitionRemaining = transitionLen;
+}
