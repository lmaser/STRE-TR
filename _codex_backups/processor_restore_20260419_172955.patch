+
+void STRETRAudioProcessor::updateFft2CanonicalCloudForState (StftState& state, Fft2RuntimeState& runtime,
+                                                             int fftSize, int analysisFftSize, int analysisHop, int synthesisHop,
+                                                             float holdCoeff, float spectralDiffusion,
+                                                             float* debugFrameRms) noexcept
+{
+	if ((! fftUseDirectFftw_ && fft_ == nullptr) || inputBufLen_ <= 0 || fftSize <= 0)
+		return;
+
+	constexpr int canonicalBins = kMaxFftBins;
+	const int requestedAnalysisFftSize = juce::jlimit (kWindowMin,
+	                                                   kMaxFftSize,
+	                                                   (analysisFftSize > 0) ? analysisFftSize : fftSize);
+	int effectiveAnalysisFftSize = requestedAnalysisFftSize;
+	if (effectiveAnalysisFftSize != fftSize && ! ensureDirectFftw (effectiveAnalysisFftSize))
+		effectiveAnalysisFftSize = fftSize;
+
+	const int analysisNumBins = juce::jlimit (1, kMaxFftBins, effectiveAnalysisFftSize / 2 + 1);
+	const bool updateCanonicalAnalysis = (analysisHop > 0)
+		|| ! runtime.hasCanonicalMemory
+		|| ! state.hasFrame
+		|| state.cyclesSinceReset <= 0;
+	if (! updateCanonicalAnalysis)
+		return;
+
+	const int effectiveAnalysisHop = juce::jmax (1, (analysisHop > 0) ? analysisHop : synthesisHop);
+	const float twoPi = juce::MathConstants<float>::twoPi;
+	const float pi = juce::MathConstants<float>::pi;
+	const float analysisExpBase = twoPi / (float) effectiveAnalysisFftSize;
+	const float blend = juce::jlimit (0.0f, 1.0f, 1.0f - holdCoeff);
+	const float effectiveHoldCoeff = 1.0f - blend;
+	const float diffusion = juce::jlimit (0.0f, 1.0f, spectralDiffusion);
+	const float windowScale = juce::jmax (0.0f,
+	                                      std::log2 ((float) juce::jmax (64, fftSize) / 1024.0f));
+	const float windowNorm = juce::jlimit (0.0f, 1.0f, windowScale / 3.0f);
+	const float diffusionStrength = juce::jlimit (0.0f, 0.975f,
+	                                              diffusion * (0.68f + 0.38f * windowNorm));
+	const int diffusionPasses = juce::jlimit (0, 6,
+	                                          (int) std::lround (diffusion * (1.0f + 3.0f * windowNorm) * 4.0f));
+	const float diffusionAlpha = juce::jlimit (0.0f, 0.82f,
+	                                           diffusionStrength * (0.20f + 0.12f * windowNorm));
+	const int readStart = (inputBufWritePos_ - effectiveAnalysisFftSize + inputBufLen_) & inputBufMask_;
+
+	auto sampleLinearSized = [] (const float* src, int bins, float srcPos) noexcept
+	{
+		if (bins <= 1)
+			return src[0];
+		const int s0 = juce::jlimit (0, bins - 1, (int) std::floor (srcPos));
+		const int s1 = juce::jlimit (0, bins - 1, s0 + 1);
+		const float frac = juce::jlimit (0.0f, 1.0f, srcPos - (float) s0);
+		return src[s0] + (src[s1] - src[s0]) * frac;
+	};
+
+	auto samplePhaseSized = [] (const float* src, int bins, float srcPos) noexcept
+	{
+		if (bins <= 1)
+			return src[0];
+		const int s0 = juce::jlimit (0, bins - 1, (int) std::floor (srcPos));
+		const int s1 = juce::jlimit (0, bins - 1, s0 + 1);
+		const float frac = juce::jlimit (0.0f, 1.0f, srcPos - (float) s0);
+		const float a = src[s0];
+		const float b = src[s1];
+		return wrapPhaseToPiFast (a + wrapPhaseToPiFast (b - a) * frac);
+	};
+
+	const int renderBins = juce::jlimit (1, kMaxFftBins, fftSize / 2 + 1);
+	for (int ch = 0; ch < 2; ++ch)
+	{
+		float frameEnergy = 0.0f;
+		float analysisMag[kMaxFftBins] = {};
+		float analysisFreq[kMaxFftBins] = {};
+		float analysisPhase[kMaxFftBins] = {};
+		float updatedCanonicalMag[kMaxFftBins] = {};
+		float updatedCanonicalFreq[kMaxFftBins] = {};
+
+		for (int j = 0; j < effectiveAnalysisFftSize; ++j)
+		{
+			const int idx = (readStart + j) & inputBufMask_;
+			const float analysisWindow = 0.5f * (1.0f - std::cos (twoPi * (float) j / (float) effectiveAnalysisFftSize));
+			fftWork_[j] = inputBuf_[ch][(size_t) idx] * analysisWindow;
+			frameEnergy += fftWork_[j] * fftWork_[j];
+		}
+		for (int j = effectiveAnalysisFftSize; j < effectiveAnalysisFftSize * 2; ++j)
+			fftWork_[j] = 0.0f;
+
+		performRealOnlyForwardTransform (fftWork_, effectiveAnalysisFftSize, true);
+
+		const bool analysisHistoryReady = runtime.hasAnalysisPhaseMemory && state.hasFrame && state.cyclesSinceReset > 0;
+		for (int k = 0; k < analysisNumBins; ++k)
+		{
+			const float re = fftWork_[k * 2];
+			const float im = fftWork_[k * 2 + 1];
+			const float mag = std::sqrt (re * re + im * im);
+			const float ph = std::atan2 (im, re);
+
+			float phaseDiff = ph - runtime.analysisPrevPhase[ch][k];
+			runtime.analysisPrevPhase[ch][k] = ph;
+
+			phaseDiff -= analysisExpBase * (float) k * (float) effectiveAnalysisHop;
+			while (phaseDiff >  pi) phaseDiff -= twoPi;
+			while (phaseDiff < -pi) phaseDiff += twoPi;
+			const float freq = analysisHistoryReady
+				? (analysisExpBase * (float) k + phaseDiff / (float) effectiveAnalysisHop)
+				: (analysisExpBase * (float) k);
+
+			analysisMag[k] = mag;
+			analysisFreq[k] = freq;
+			analysisPhase[k] = ph;
+		}
+		runtime.hasAnalysisPhaseMemory = true;
+
+		if (! runtime.hasCanonicalMemory || ! state.hasFrame || state.cyclesSinceReset <= 0)
+		{
+			for (int kc = 0; kc < canonicalBins; ++kc)
+			{
+				const float srcPos = (canonicalBins > 1)
+					? ((float) kc / (float) (canonicalBins - 1)) * (float) (analysisNumBins - 1)
+					: 0.0f;
+				runtime.canonicalHeldMag[ch][kc] = sampleLinearSized (analysisMag, analysisNumBins, srcPos);
+				runtime.canonicalHeldFreq[ch][kc] = sampleLinearSized (analysisFreq, analysisNumBins, srcPos);
+			}
+		}
+		else
+		{
+			if (diffusion > 0.0001f && diffusionPasses > 0)
+			{
+				std::memcpy (updatedCanonicalMag, runtime.canonicalHeldMag[ch], sizeof (updatedCanonicalMag));
+				std::memcpy (updatedCanonicalFreq, runtime.canonicalHeldFreq[ch], sizeof (updatedCanonicalFreq));
+
+				for (int pass = 0; pass < diffusionPasses; ++pass)
+				{
+					for (int kc = 1; kc < canonicalBins; ++kc)
+					{
+						updatedCanonicalMag[kc] += diffusionAlpha * (updatedCanonicalMag[kc - 1] - updatedCanonicalMag[kc]);
+						updatedCanonicalFreq[kc] += diffusionAlpha * (updatedCanonicalFreq[kc - 1] - updatedCanonicalFreq[kc]);
+					}
+
+					for (int kc = canonicalBins - 2; kc >= 0; --kc)
+					{
+						updatedCanonicalMag[kc] += diffusionAlpha * (updatedCanonicalMag[kc + 1] - updatedCanonicalMag[kc]);
+						updatedCanonicalFreq[kc] += diffusionAlpha * (updatedCanonicalFreq[kc + 1] - updatedCanonicalFreq[kc]);
+					}
+				}
+			}
+			else
+			{
+				std::memcpy (updatedCanonicalMag, runtime.canonicalHeldMag[ch], sizeof (updatedCanonicalMag));
+				std::memcpy (updatedCanonicalFreq, runtime.canonicalHeldFreq[ch], sizeof (updatedCanonicalFreq));
+			}
+
+			for (int kc = 0; kc < canonicalBins; ++kc)
+			{
+				const float srcPos = (canonicalBins > 1)
+					? ((float) kc / (float) (canonicalBins - 1)) * (float) (analysisNumBins - 1)
+					: 0.0f;
+				const float mag = sampleLinearSized (analysisMag, analysisNumBins, srcPos);
+				const float freq = sampleLinearSized (analysisFreq, analysisNumBins, srcPos);
+
+				const float retainedMag = updatedCanonicalMag[kc];
+				const float retainedFreq = updatedCanonicalFreq[kc];
+
+				updatedCanonicalMag[kc] = effectiveHoldCoeff * retainedMag + blend * mag;
+				updatedCanonicalFreq[kc] = effectiveHoldCoeff * retainedFreq + blend * freq;
+			}
+
+			std::memcpy (runtime.canonicalHeldMag[ch], updatedCanonicalMag, sizeof (updatedCanonicalMag));
+			std::memcpy (runtime.canonicalHeldFreq[ch], updatedCanonicalFreq, sizeof (updatedCanonicalFreq));
+		}
+
+		for (int k = 0; k < renderBins; ++k)
+		{
+			const float analysisPos = (renderBins > 1)
+				? ((float) k / (float) (renderBins - 1)) * (float) (analysisNumBins - 1)
+				: 0.0f;
+			state.prevPhase[ch][k] = samplePhaseSized (analysisPhase, analysisNumBins, analysisPos);
+			state.lastMag[ch][k] = sampleLinearSized (analysisMag, analysisNumBins, analysisPos);
+			state.lastFreq[ch][k] = sampleLinearSized (analysisFreq, analysisNumBins, analysisPos);
+		}
+
+		if (debugFrameRms != nullptr)
+			debugFrameRms[ch] = std::sqrt (frameEnergy / (float) juce::jmax (1, effectiveAnalysisFftSize));
+	}
+
+	runtime.hasCanonicalMemory = true;
+	runtime.lastCloudAnalysisHop = effectiveAnalysisHop;
+	state.analysisReadPos = (double) readStart;
+}
