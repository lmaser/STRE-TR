+void STRETRAudioProcessor::captureFft1FreezeLoop (int fftSize) noexcept
+{
+	const int loopLength = juce::jlimit (64, kMaxFftSize, fftSize);
+	if (loopLength <= 0)
+	{
+		fft1State_.freezeLoopLength = 0;
+		fft1State_.freezeLoopReadPos = 0;
+		fft1State_.freezeLoopReady = false;
+		return;
+	}
+
+	const int startHistoryPos = (fftWetHistoryWritePos_ - loopLength + kFftWetHistoryLen) & (kFftWetHistoryLen - 1);
+	for (int ch = 0; ch < 2; ++ch)
+	{
+		for (int i = 0; i < loopLength; ++i)
+		{
+			const int histIdx = (startHistoryPos + i) & (kFftWetHistoryLen - 1);
+			fftFreezeLoop_[ch][i] = fftWetHistory_[ch][histIdx];
+		}
+
+		const int fadeSamples = juce::jlimit (32, juce::jmax (32, loopLength / 16), 256);
+		if (fadeSamples * 2 < loopLength)
+		{
+			for (int i = 0; i < fadeSamples; ++i)
+			{
+				const float t = (fadeSamples > 1)
+					? ((float) i / (float) (fadeSamples - 1))
+					: 1.0f;
+				const float smoothT = t * t * (3.0f - 2.0f * t);
+				const float startSample = fftFreezeLoop_[ch][i];
+				const float endSample = fftFreezeLoop_[ch][loopLength - fadeSamples + i];
+				const float seamSample = endSample * (1.0f - smoothT) + startSample * smoothT;
+				fftFreezeLoop_[ch][i] = seamSample;
+				fftFreezeLoop_[ch][loopLength - fadeSamples + i] = seamSample;
+			}
+		}
+	}
+
+	fft1State_.freezeLoopLength = loopLength;
+	fft1State_.freezeLoopReady = true;
+	if (fft1State_.freezeTransitionTotal > 0 && fft1State_.freezeTransitionTotal < loopLength)
+		fft1State_.freezeLoopReadPos = loopLength - fft1State_.freezeTransitionTotal;
+	else
+		fft1State_.freezeLoopReadPos = 0;
+}
