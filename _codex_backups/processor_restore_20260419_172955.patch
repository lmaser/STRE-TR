+void STRETRAudioProcessor::performRealOnlyForwardTransform (float* inputOutputData,
+                                                            int fftSize,
+                                                            bool ignoreNegativeFreqs)
+{
+#if JUCE_WINDOWS && JUCE_DSP_USE_SHARED_FFTW
+	DirectFftwPlanSlot* slot = nullptr;
+	if (fftUseDirectFftw_)
+	{
+		for (auto& s : fftwPlanSlots_)
+		{
+			if (s.fftSize == fftSize && s.planR2C != nullptr && s.planC2R != nullptr)
+			{
+				slot = &s;
+				s.useStamp = ++fftwPlanUseCounter_;
+				break;
+			}
+		}
+	}
+	if (slot != nullptr)
+	{
+		const int numBins = fftSize / 2 + 1;
+		std::memcpy (slot->time.getData(), inputOutputData, (size_t) fftSize * sizeof (float));
+		g_stretrDirectFftw.executeR2C ((StretrDirectFftwSymbols::FFTWPlanRef) slot->planR2C,
+		                               slot->time.getData(),
+		                               slot->bins.getData());
+
+		auto* out = reinterpret_cast<juce::dsp::Complex<float>*> (inputOutputData);
+		for (int i = 0; i < numBins; ++i)
+			out[i] = slot->bins[i];
+
+		if (! ignoreNegativeFreqs)
+		{
+			for (int i = fftSize >> 1; i < fftSize; ++i)
+				out[i] = std::conj (out[fftSize - i]);
+		}
+		return;
+	}
+#endif
+
+	if (fft_ != nullptr)
+		fft_->performRealOnlyForwardTransform (inputOutputData, ignoreNegativeFreqs);
+}
+
+void STRETRAudioProcessor::performRealOnlyInverseTransform (float* inputOutputData, int fftSize)
+{
+#if JUCE_WINDOWS && JUCE_DSP_USE_SHARED_FFTW
+	DirectFftwPlanSlot* slot = nullptr;
+	if (fftUseDirectFftw_)
+	{
+		for (auto& s : fftwPlanSlots_)
+		{
+			if (s.fftSize == fftSize && s.planR2C != nullptr && s.planC2R != nullptr)
+			{
+				slot = &s;
+				s.useStamp = ++fftwPlanUseCounter_;
+				break;
+			}
+		}
+	}
+	if (slot != nullptr)
+	{
+		const int numBins = fftSize / 2 + 1;
+		auto* in = reinterpret_cast<juce::dsp::Complex<float>*> (inputOutputData);
+		for (int i = 0; i < numBins; ++i)
+			slot->bins[i] = in[i];
+
+		g_stretrDirectFftw.executeC2R ((StretrDirectFftwSymbols::FFTWPlanRef) slot->planC2R,
+		                               slot->bins.getData(),
+		                               slot->time.getData());
+		juce::FloatVectorOperations::multiply (slot->time.getData(),
+		                                       1.0f / (float) juce::jmax (1, fftSize),
+		                                       fftSize);
+		std::memcpy (inputOutputData, slot->time.getData(), (size_t) fftSize * sizeof (float));
+		return;
+	}
+#endif
+
+	if (fft_ != nullptr)
+		fft_->performRealOnlyInverseTransform (inputOutputData);
+}
