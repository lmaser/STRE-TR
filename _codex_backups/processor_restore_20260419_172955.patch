+
+void STRETRAudioProcessor::readStftWet (const StftState& state, float& outL, float& outR) const noexcept
+{
+	const float norm = state.outputNormAccum[state.outputReadPos];
+	const float invNorm = (norm > 1.0e-6f) ? (1.0f / norm) : 0.0f;
+	outL = state.outputAccum[0][state.outputReadPos] * invNorm;
+	outR = state.outputAccum[1][state.outputReadPos] * invNorm;
+}
+
+void STRETRAudioProcessor::consumeStftWet (StftState& state) noexcept
+{
+	const int outBufLen = kStftOutBufLen;
+	state.outputAccum[0][state.outputReadPos] = 0.0f;
+	state.outputAccum[1][state.outputReadPos] = 0.0f;
+	state.outputNormAccum[state.outputReadPos] = 0.0f;
+	state.outputReadPos = (state.outputReadPos + 1) & (outBufLen - 1);
+}
