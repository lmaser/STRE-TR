+void STRETRAudioProcessor::clearFftWindowTransition() noexcept
+{
+	stftPendingActive_ = false;
+	stftPending_.activeFftSize = 0;
+	stftPending_.synthCounter = 0;
+	fft2PendingState_ = {};
+		fftWindowState_.engine = 0;
+		fftWindowState_.fft2LiveTransitionBlend = 0.0f;
+		fftWindowState_.fft2Downsizing = false;
+		fftWindowState_.sizeTransitionRemaining = 0;
+		fftWindowState_.sizeTransitionTotal = 0;
+	fftWindowState_.sizeTransitionWarmupRemaining = 0;
+	fftWindowState_.sizeTransitionWarmupTotal = 0;
+	fftWindowState_.sizeTransitionMinWarmupRemaining = 0;
+	fftWindowState_.sizeTransitionReadyCount = 0;
+	fftWindowState_.sizeTransitionReadyTarget = 0;
+}
+
+void STRETRAudioProcessor::commitFftWindowTransition() noexcept
+{
+	if (! stftPendingActive_)
+	{
+		clearFftWindowTransition();
+		return;
+	}
+
+	const int transitionEngine = fftWindowState_.engine;
+	const int oldFftSize = stft_.activeFftSize;
+	const int newFftSize = stftPending_.activeFftSize;
+	const int oldHop = (oldFftSize > 0) ? recommendedFftSynthHopForEngine (transitionEngine, oldFftSize) : 0;
+	const int newHop = (newFftSize > 0) ? recommendedFftSynthHopForEngine (transitionEngine, newFftSize) : 0;
+	const int oldWetLatency = (oldFftSize > 0) ? (oldFftSize + oldHop) : 0;
+	const int newWetLatency = (newFftSize > 0) ? (newFftSize + newHop) : 0;
+
+	stft_ = stftPending_;
+	if (transitionEngine == 3)
+		fft2State_ = fft2PendingState_;
+	clearFftWindowTransition();
+
+	if (oldWetLatency > 0 && newWetLatency > 0 && oldWetLatency != newWetLatency)
+	{
+		fftWindowState_.engine = transitionEngine;
+		fftWindowState_.sizeAlignTransitionTotal = juce::jlimit (16,
+		                                                         512,
+		                                                         juce::jmax (std::abs (newWetLatency - oldWetLatency),
+		                                                                     juce::jmax (oldHop, newHop)));
+		fftWindowState_.sizeAlignTransitionRemaining = fftWindowState_.sizeAlignTransitionTotal;
+		fftWindowState_.sizeAlignOldWetLatency = oldWetLatency;
+		fftWindowState_.sizeAlignNewWetLatency = newWetLatency;
+	}
+	else
+	{
+		fftWindowState_.sizeAlignTransitionRemaining = 0;
+		fftWindowState_.sizeAlignTransitionTotal = 0;
+		fftWindowState_.sizeAlignOldWetLatency = 0;
+		fftWindowState_.sizeAlignNewWetLatency = 0;
+	}
+}
+
+void STRETRAudioProcessor::startFftWindowTransition (int engineVal, double capturePos, int oldFftSize, int newFftSize,
+                                                     float fft2LiveTransitionBlend) noexcept
+{
+	if (oldFftSize <= 0 || newFftSize <= 0 || oldFftSize == newFftSize)
+	{
+		clearFftWindowTransition();
+		return;
+	}
+
+	ensureFft (newFftSize);
+	resetStftStateAtPos (stftPending_, capturePos, newFftSize);
+	stftPendingActive_ = true;
+	fftWindowState_.engine = engineVal;
+	fftWindowState_.fft2LiveTransitionBlend = (engineVal == 3)
+		? juce::jlimit (0.0f, 1.0f, fft2LiveTransitionBlend)
+		: 0.0f;
+	fftWindowState_.fft2Downsizing = (engineVal == 3 && newFftSize < oldFftSize);
+	if (engineVal == 3)
+	{
+		fft2PendingState_ = {};
+		seedFft2StateForTransition (stft_, fft2State_, stftPending_, fft2PendingState_);
+	}
+
+	const int oldHop = recommendedFftSynthHopForEngine (engineVal, oldFftSize);
+	const int newHop = recommendedFftSynthHopForEngine (engineVal, newFftSize);
+	const int oldWetLatency = oldFftSize + oldHop;
+	const int newWetLatency = newFftSize + newHop;
+	int maxWarmup = juce::jlimit (32,
+	                              kFftWetHistoryLen - 1,
+	                              juce::jmax (oldWetLatency, newWetLatency)
+	                                  + juce::jmax (oldHop, newHop));
+	int minWarmup = juce::jlimit (16,
+	                              juce::jmax (16, maxWarmup),
+	                              juce::jmax (16, juce::jmin (oldWetLatency, newWetLatency) / 2));
+	int readyTarget = juce::jlimit (8,
+	                                256,
+	                                juce::jmax (8, juce::jmax (oldHop, newHop)));
+	if (engineVal == 3)
