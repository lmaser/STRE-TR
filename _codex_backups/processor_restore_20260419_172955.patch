+
+void STRETRAudioProcessor::captureWsolaHoldSource (double nominalPos, int segLen, int seekRadius,
+                                                   float pitchRate, bool reverseOn, bool wideMode) noexcept
+{
+	const double readTravel = (double) juce::jmax (1.0f, std::abs (pitchRate)) * (double) juce::jmax (0, segLen - 1);
+	const double wideExtra = wideMode ? (double) (segLen / 2) : 0.0;
+	const double preRoll = (double) seekRadius + readTravel + 8.0;
+	const double postRoll = (double) seekRadius + readTravel + wideExtra + 8.0;
+	const int holdLen = juce::jlimit (64,
+	                                  kWindowMax,
+	                                  (int) std::ceil (preRoll + postRoll + 1.0));
+	const double basePos = nominalPos - preRoll;
+
+	for (int n = 0; n < holdLen; ++n)
+	{
+		const double srcPos = basePos + (double) n;
+		wsola_.holdSourceL[n] = readInputBuf (0, srcPos);
+		wsola_.holdSourceR[n] = readInputBuf (1, srcPos);
+	}
+
+	for (int n = holdLen; n < kWindowMax; ++n)
+	{
+		wsola_.holdSourceL[n] = 0.0f;
+		wsola_.holdSourceR[n] = 0.0f;
+	}
+
+	wsola_.holdSourceBasePos = basePos;
+	wsola_.holdSourceLen = holdLen;
+	wsola_.holdSourceActive = true;
+	juce::ignoreUnused (reverseOn);
+}
