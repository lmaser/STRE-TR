+bool STRETRAudioProcessor::ensureDirectFftw (int fftSize)
+{
+#if JUCE_WINDOWS && JUCE_DSP_USE_SHARED_FFTW
+	if (fftSize <= 0)
+	{
+		releaseDirectFftw();
+		return false;
+	}
+
+	if (! resolveStretrDirectFftwSymbols())
+	{
+		releaseDirectFftw();
+		return false;
+	}
+
+	auto findSlot = [&] (int size) -> DirectFftwPlanSlot*
+	{
+		for (auto& slot : fftwPlanSlots_)
+		{
+			if (slot.fftSize == size && slot.planR2C != nullptr && slot.planC2R != nullptr)
+				return &slot;
+		}
+		return nullptr;
+	};
