+	if (currentBucket > 64)
+	{
+		const int lowerBucket = currentBucket / 2;
+		const float boundary = 0.5f * ((float) lowerBucket + (float) currentBucket);
+		const float hysteresis = juce::jmax (8.0f, (float) lowerBucket * 0.0625f);
