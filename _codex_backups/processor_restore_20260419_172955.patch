+	if (auto* slot = findSlot (fftSize))
+	{
+		slot->useStamp = ++fftwPlanUseCounter_;
+		fftUseDirectFftw_ = true;
+		return true;
+	}
+
+	auto destroySlot = [&] (DirectFftwPlanSlot& slot)
+	{
+		if (g_stretrDirectFftw.resolved)
+		{
+			const juce::ScopedLock lock (getStretrDirectFftwPlanLock());
+			if (slot.planR2C != nullptr)
+				g_stretrDirectFftw.destroyPlan ((StretrDirectFftwSymbols::FFTWPlanRef) slot.planR2C);
+			if (slot.planC2R != nullptr)
+				g_stretrDirectFftw.destroyPlan ((StretrDirectFftwSymbols::FFTWPlanRef) slot.planC2R);
+		}
+
+		slot.planR2C = nullptr;
+		slot.planC2R = nullptr;
+		slot.fftSize = 0;
+		slot.useStamp = 0;
+		slot.time.free();
+		slot.bins.free();
+	};
+
+	const int numBins = fftSize / 2 + 1;
+	DirectFftwPlanSlot* targetSlot = nullptr;
+	for (auto& slot : fftwPlanSlots_)
+	{
+		if (slot.planR2C == nullptr && slot.planC2R == nullptr)
+		{
+			targetSlot = &slot;
+			break;
+		}
+	}
+
+	if (targetSlot == nullptr)
+	{
+		targetSlot = &fftwPlanSlots_[0];
+		for (auto& slot : fftwPlanSlots_)
+			if (slot.useStamp < targetSlot->useStamp)
+				targetSlot = &slot;
+		destroySlot (*targetSlot);
+	}
+
+	targetSlot->time.allocate ((size_t) fftSize, true);
+	targetSlot->bins.allocate ((size_t) juce::jmax (1, numBins), true);
+
+	juce::HeapBlock<float> planTime ((size_t) fftSize, true);
+	juce::HeapBlock<juce::dsp::Complex<float>> planBins ((size_t) juce::jmax (1, numBins), true);
+
+	{
+		const juce::ScopedLock lock (getStretrDirectFftwPlanLock());
+		targetSlot->planR2C = g_stretrDirectFftw.planR2C ((unsigned) fftSize,
+		                                                  planTime.getData(),
+		                                                  planBins.getData(),
+		                                                  kStretrFftwUnaligned | kStretrFftwEstimate);
+		targetSlot->planC2R = g_stretrDirectFftw.planC2R ((unsigned) fftSize,
+		                                                  planBins.getData(),
+		                                                  planTime.getData(),
+		                                                  kStretrFftwUnaligned | kStretrFftwEstimate);
+	}
+
+	if (targetSlot->planR2C == nullptr || targetSlot->planC2R == nullptr)
+	{
+		destroySlot (*targetSlot);
+		return false;
+	}
