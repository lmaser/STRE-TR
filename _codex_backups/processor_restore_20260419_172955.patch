+	                                        (float) kWindowMax,
+	                                        (float) fftSize);
+	const float lowWindowNorm = juce::jlimit (0.0f, 1.0f,
+	                                          (256.0f - clampedSize) / (256.0f - (float) kWindowMin));
+	const float smoothLowWindowNorm = lowWindowNorm * lowWindowNorm * (3.0f - 2.0f * lowWindowNorm);
